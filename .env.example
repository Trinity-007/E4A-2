# E4A - Deployment Environment Variables

# Server
NODE_ENV=production
PORT=3000

# Email Configuration (for production)
# Use your own SMTP provider (Gmail, SendGrid, Mailgun, etc.)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password

# Database (for production, consider PostgreSQL or MongoDB)
# Currently using SQLite which is fine for small deployments
